# Copy to .env and fill in what you need. Every variable is optional.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/Instagram
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Base64-encoded key of at least 256 bits, e.g. generated with: openssl rand -base64 48
# JWT_SECRET=

# E-mail notifications (left empty = disabled)
MAIL_USERNAME=
MAIL_PASSWORD=

# SMS notifications via Twilio (left empty = disabled)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

SCORING_SERVICE_URL=http://localhost:8081
